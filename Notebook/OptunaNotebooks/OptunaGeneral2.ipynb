    "fig.show()\n",
    "\n",
    "# Plot parameter importances\n",
    "fig = plot_param_importances(study)\n",
    "fig.show()\n",
    "\n",
    "# Plot parallel coordinate (shows relationship between hyperparameters and objective value)\n",
    "fig = plot_parallel_coordinate(study)\n",
    "fig.show()"
