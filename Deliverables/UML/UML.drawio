20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20__plotPcaNumComponentsPerFeature()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3A%20pre%3B%26quot%3B%26gt%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Plot%20the%20number%20of%20PCA%20components%20selected%20per%20feature.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20apply_pca()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Apply%20PCA%20to%20reduce%20dimensionality%20of%20the%20data.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20apply_feature_selection()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Select%20specific%20features%20from%20the%20data.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20preprocess()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Main%20preprocessing%20function%20to%20load%2C%20process%2C%20and%20save%20data.%26lt%3B%2Fp%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bbackground-color%3A%20transparent%3B%20color%3A%20light-dark(rgb(0%2C%200%2C%200)%2C%20rgb(255%2C%20255%2C%20255))%3B%26quot%3B%26gt%3B.%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%22%20style%3D%22verticalAlign%3Dtop%3Balign%3Dleft%3Boverflow%3Dfill%3Bhtml%3D1%3BwhiteSpace%3Dwrap%3BfillColor%3D%23fff2cc%3BstrokeColor%3D%23d6b656%3BfontStyle%3D1%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%2250%22%20y%3D%2280%22%20width%3D%22660%22%20height%3D%22230%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- decoderInterpreter&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;# ParameterInterpreter defining available layers and activations.&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;div&gt;&amp;nbsp;+ __init__()&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;# Initialize the Decoder with parameters, build the network layers.&lt;/div&gt;&lt;div&gt;&amp;nbsp;+ forward()&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;# Forward pass for the decoder, handling both feedforward and recurrent layers.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
