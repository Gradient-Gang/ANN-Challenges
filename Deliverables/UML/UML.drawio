        <mxCell id="7S10kJRi6ghTLGnXOAkf-1" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Decoder&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-weight: 400; text-wrap-mode: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-top%3A4px%3Btext-align%3Acenter%3B%26quot%3B%26gt%3B%26lt%3Bspan%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2015px%3B%26quot%3B%26gt%3BPreProcessor%26lt%3B%2Ffont%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bhr%20size%3D%26quot%3B1%26quot%3B%20style%3D%26quot%3Bborder-style%3Asolid%3B%26quot%3B%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20fromYaml()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Builds%20a%20PreProcessor%20from%20a%20YAML%20file.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20__init__()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Initialize%20the%20PreProcessor%20with%20given%20parameters.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20load_data()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Load%20data%20from%20a%20CSV%20file.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20save_data()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Save%20data%20to%20a%20CSV%20file.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20remove_last_column()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Remove%20the%20last%20column%20from%20the%20DataFrame.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20handle_is_pirate_features()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Handle%20isPirate%20features%20by%20dropping%20or%20encoding%20them.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20normalize_per_process()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Normalize%20numerical%20features%20to%20have%20zero%20mean%20and%20unit%20variance.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20plot_one_time_series()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Plot%20a%20single%20time%20series%20from%20the%20DataFrame.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20__aggregate_time_series()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Aggregate%20time%20series%20data%20into%20a%203D%20NumPy%20array.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20__plotPcaNumComponentsPerFeature()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3A%20pre%3B%26quot%3B%26gt%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Plot%20the%20number%20of%20PCA%20components%20selected%20per%20feature.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20apply_pca()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Apply%20PCA%20to%20reduce%20dimensionality%20of%20the%20data.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20apply_feature_selection()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Select%20specific%20features%20from%20the%20data.%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%2B%20preprocess()%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3Apre%26quot%3B%26gt%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%23%20Main%20preprocessing%20function%20to%20load%2C%20process%2C%20and%20save%20data.%26lt%3B%2Fp%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A0px%3Bmargin-left%3A4px%3B%26quot%3B%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bbackground-color%3A%20transparent%3B%20color%3A%20light-dark(rgb(0%2C%200%2C%200)%2C%20rgb(255%2C%20255%2C%20255))%3B%26quot%3B%26gt%3B.%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%22%20style%3D%22verticalAlign%3Dtop%3Balign%3Dleft%3Boverflow%3Dfill%3Bhtml%3D1%3BwhiteSpace%3Dwrap%3BfillColor%3D%23fff2cc%3BstrokeColor%3D%23d6b656%3BfontStyle%3D1%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%2250%22%20y%3